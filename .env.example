# ==============================================================================
# متغیرهای محیطی پروژه ربات خدمات ضدسرقت خودرو (Car Security Bot)
# جهت اجرا در پلن کاملاً رایگان Render (Free Web Service) این مقادیر را در تب Environment وارد کنید.
# ==============================================================================

# توکن ربات دریافتی از @BotFather (در تلگرام یا بله)
# نمونه: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567
BOT_TOKEN=your_bot_token_here

# شناسه عددی کاربری مدیر (شناسه اکانت تلگرام یا بله شما)
# نمونه: 987654321
ADMIN_ID=your_numerical_admin_id_here

# پورت وب‌سرور جهت استقرار در رندر (Render Web Service Free Tier)
# در پلتفرم Render متغیر PORT به صورت خودکار یا با مقدار 10000 تنظیم می‌شود
PORT=10000

# نوع پیام‌رسان: telegram (برای تلگرام) یا bale (برای پیام‌رسان بله)
# پیش‌فرض: telegram
MESSENGER=telegram

# آدرس سرور API بازوهای بله (تنها در صورت استفاده از MESSENGER=bale مورد نیاز است)
BALE_API_URL=https://tapi.bale.ai

# مسیر ذخیره فایل پایگاه داده SQLite
# در Render مسیر پیش‌فرض bot_database.db در دایرکتوری کاری کانتینر قرار می‌گیرد
DB_PATH=bot_database.db

# مسیر ماژول‌های پایتون (جهت یافتن پوشه handlers)
PYTHONPATH=.
