# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# تنظیمات بازوی پیام‌رسان بله (و تلگرام)
# ==========================================

# نوع پیام‌رسان: bale (برای بله) یا telegram (برای تلگرام)
MESSENGER=bale

# آدرس سرور API بازوهای بله (پیش‌فرض رسمی: https://tapi.bale.ai)
BALE_API_URL=https://tapi.bale.ai

# توکن بازوی دریافتی از @BotFather در بله (یا تلگرام)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# شناسه عددی کاربری مدیر در بله (یا تلگرام) جهت دسترسی به /admin
ADMIN_ID=987654321

# مسیر ذخیره فایل پایگاه داده SQLite
DB_PATH=bot_database.db
