# تنظیمات اتصال بازوی پیام‌رسان بله (یا تلگرام) برای ثبت سفارش ضدسرقت خودرو
# برای اجرای بازو، این فایل را با نام .env ذخیره کرده و مقادیر را تکمیل فرمایید.

# نوع پیام‌رسان: bale (برای بله) یا telegram (برای تلگرام)
MESSENGER=bale

# آدرس سرور API بازوهای بله (پیش‌فرض: https://tapi.bale.ai)
BALE_API_URL=https://tapi.bale.ai

# توکن بازوی دریافتی از @BotFather در پیام‌رسان بله
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# شناسه عددی کاربری مدیر در پیام‌رسان بله (از بات @userinfobot یا پروفایل بله)
ADMIN_ID=987654321

# مسیر فایل دیتابیس SQLite
DB_PATH=bot_database.db
